{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Federa",
  "version": "0.0.0",
  "identifier": "com.aikuora.federa",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm exec vp dev",
    "beforeBuildCommand": "pnpm exec vp build"
  },
  "app": {
    "windows": [{ "title": "Federa", "width": 1100, "height": 720 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
